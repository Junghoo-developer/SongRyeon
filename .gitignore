# Python이 실행 중 자동으로 만드는 파일
__pycache__/
*.py[cod]

# pytest 캐시와 로컬 가상환경
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# 빌드 결과
build/
dist/
*.egg-info/

# 비밀값과 로컬 설정
.env
.env.*
!.env.example

# 실제 기억과 로컬 실행 데이터
memory/memory.jsonl
/tmp/
/.tmp/
/.codex-remote-attachments/
*.log
