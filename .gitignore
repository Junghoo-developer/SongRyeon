# Python이 실행 중 자동으로 만드는 파일
__pycache__/
*.py[cod]

# pytest 캐시와 로컬 가상환경
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# 빌드 결과
build/
dist/
*.egg-info/

# 비밀값과 로컬 설정
.env
.env.*
!.env.example

# 실제 기억과 로컬 실행 데이터
memory/memory.jsonl
/tmp/
/.tmp/
/.codex-remote-attachments/
*.log

# 평가 산출물에는 전체 프롬프트, 원시 응답, thinking이 포함될 수 있다.
**/capture.json
**/CAPTURE.json
**/checkpoint.json
**/CHECKPOINT.json
**/transcripts/
**/TRANSCRIPTS/
**/blind_key.json
**/BLIND_KEY.json
**/blind_packet.json
**/BLIND_PACKET.json
# 대회용 합성 holdout의 검증 가능한 공개 packet만 예외로 둔다.
!evals/contest_holdout_v1/frozen/*/BLIND_PACKET.json
**/raw/
**/RAW/
# FREEZE.json과 BLINDING_COMMITMENT.json은 비밀이 없는 공개 동결 증명이므로 제외하지 않는다.
*.memory.jsonl
*.tmp

# 대회 포털에 별도로 제출하거나 참가자만 보는 작업 파일
/submission/*.docx
/submission/*.pdf
/submission/owner_review_checklist.md
/submission/result_report_draft.md
