# Copy this file to .env and fill only the values used on your machine.
# The real .env is ignored by Git.

QWEN_MODEL_ID=qwen3:14b
SONGRYEON_DEFAULT_TIMEOUT_SECONDS=180
SONGRYEON_DEFAULT_LIVE_TRACE=true
SONGRYEON_DEFAULT_ENABLE_VESSEL_R=auto

SONGRYEON_NEO4J_URI=bolt://localhost:7687
SONGRYEON_NEO4J_USER=neo4j
SONGRYEON_NEO4J_DATABASE=neo4j
SONGRYEON_NEO4J_PASSWORD=replace-with-local-password
